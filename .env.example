# Copy to .env and change every secret before exposing a world to the internet.
OVIAN_JWT_SECRET=change-me-to-at-least-32-random-characters
OVIAN_INTERNAL_KEY=change-me-broker-to-server-key
OVIAN_MQTT_SERVICE_PASSWORD=change-me-server-to-broker-password

# Content pack folder under content/ (classic, isles or antiquity) and world settings.
# Give each world its own database; create it once: docker compose exec db createdb -U ovian <name>
OVIAN_DATABASE_NAME=ovian
OVIAN_PACK=classic
OVIAN_WORLD_ID=w1
OVIAN_WORLD_SPEED=1

# Public addresses as seen from the browser.
OVIAN_MQTT_PUBLIC_URL=ws://localhost:47001
OVIAN_CORS_ORIGINS=*
# Links between the two front ends (optional).
OVIAN_LEDGER_PUBLIC_URL=
OVIAN_DIORAMA_PUBLIC_URL=
# Public URL of the MCP server for AI assistants (shown in Settings). Port: OVIAN_MCP_PORT (47002).
OVIAN_MCP_PUBLIC_URL=

# Host ports.
OVIAN_WEB_PORT=47173
OVIAN_DIORAMA_PORT=47174
OVIAN_API_PORT=47080
OVIAN_MQTT_WS_PORT=47001
OVIAN_SUBNET=10.247.10.0/24

# Comma separated usernames with superuser rights (the Admin screen).
OVIAN_ADMIN_USERS=
# Days a player waits between two changes of username.
OVIAN_RENAME_DAYS=7

# AI rulers (optional, docs/bots.md): friendly NPC kingdoms played by the "bots" service.
# Enable with COMPOSE_PROFILES=bots. OVIAN_BOT_USERS marks the accounts as bots (list the same names as OVIAN_BOTS).
#COMPOSE_PROFILES=bots
OVIAN_BOT_USERS=
# Name:tribe:persona;... (persona: statesman, general, warlord, priest, builder, or a short free-text description)
OVIAN_BOTS=
OVIAN_BOT_PASSWORD=change-me-bot-password
# A small model served by Ollama on the host; the bots fall back to canned lines without it.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=hf.co/prism-ml/Bonsai-1.7B-gguf:Q1_0

# The hub (docs/worlds.md): one account for many worlds, founders, badges, Patreon. Enable with COMPOSE_PROFILES=hub
# (with bots: COMPOSE_PROFILES=bots,hub) and create its database: docker compose exec db createdb -U ovian ovian_hub
OVIAN_HUB_JWT_SECRET=change-me-hub-login-secret-at-least-32-characters
# Shared by the hub and every world.
OVIAN_HUB_WORLD_SECRET=
OVIAN_HUB_ADMIN_USERS=
# id|name|api_url|internal_url;... ("/" = this site's main world)
OVIAN_HUB_WORLDS=w1|My world|/|http://server:8000
OVIAN_HUB_INTERNAL_URL=http://hub:8000
OVIAN_HUB_UPSTREAM=http://hub:8000
# "/hub" turns the hub login on in both clients.
OVIAN_PUBLIC_HUB_URL=
OVIAN_HUB_PUBLIC_URL=http://localhost:47174
OVIAN_HUB_PUBLIC_API_URL=http://localhost:47174/hub
OVIAN_HUB_PATREON_CLIENT_ID=
OVIAN_HUB_PATREON_CLIENT_SECRET=
OVIAN_HUB_PATREON_WEBHOOK_SECRET=
OVIAN_HUB_PATREON_CAMPAIGN_ID=
# Further worlds served by these front ends: "w3=http://server-w3:8000|http://broker-w3:9001 ..."
OVIAN_WORLDS=
# false: new players join this world only through the hub.
OVIAN_LOCAL_REGISTRATION=true

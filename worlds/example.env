# A further world (docker-compose.world.yml). Copy to worlds/<id>.env; worlds/*.env other than this one are ignored by git.
OVIAN_WORLD_ID=w3
OVIAN_DATABASE_NAME=ovian_w3
OVIAN_PACK=antiquity
OVIAN_WORLD_SPEED=3
# As browsers see this world's broker: through the web front end (/w/<id>/mqtt) or directly over TLS.
OVIAN_MQTT_PUBLIC_URL=wss://empires.ofthepast.org/w/w3/mqtt
# Secrets of this world (different from the other worlds').
OVIAN_JWT_SECRET=change-me-to-at-least-32-random-characters
OVIAN_INTERNAL_KEY=change-me-broker-to-server-key
OVIAN_MQTT_SERVICE_PASSWORD=change-me-server-to-broker-password
# Shared with the hub (its OVIAN_HUB_WORLD_SECRET).
OVIAN_HUB_WORLD_SECRET=change-me-shared-with-the-hub
# false: players come only through the hub.
OVIAN_LOCAL_REGISTRATION=false
